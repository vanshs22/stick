{
 "schema_version": 1,
 "preset": "phrase",
 "font_stack": [
  "Fraunces",
  "Georgia",
  "serif"
 ],
 "size_px": 58,
 "weight": 500,
 "case": "as-written",
 "fill": "#FFFFFF",
 "shadow": true,
 "position": {
  "y_pct": 70,
  "anchor": "center",
  "avoid": [
   "face",
   "overlay",
   "platform_buttons"
  ]
 },
 "chunking": {
  "max_words": 5,
  "syntax": "pipe-star",
  "hide_until_spoken": false
 },
 "animation": {
  "in": "fade",
  "out": "fade",
  "ms": 400,
  "active_word": "none"
 },
 "reveal": {
  "lead_ms": 60,
  "source": "whisper_words"
 }
}
