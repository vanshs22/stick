{
 "schema_version": 1,
 "preset": "one-word",
 "font_stack": [
  "Inter",
  "Archivo Black",
  "sans-serif"
 ],
 "size_px": 118,
 "weight": 900,
 "case": "as-written",
 "fill": "#FFFFFF",
 "shadow": true,
 "position": {
  "y_pct": 70,
  "anchor": "center",
  "avoid": [
   "face",
   "overlay",
   "platform_buttons"
  ]
 },
 "chunking": {
  "max_words": 1,
  "syntax": "none",
  "hide_until_spoken": true
 },
 "animation": {
  "in": "pop",
  "out": "cut",
  "ms": 260,
  "active_word": "none"
 },
 "reveal": {
  "lead_ms": 60,
  "source": "whisper_words"
 },
 "stroke": {
  "w": 8,
  "color": "#000000"
 }
}
