{
 "schema_version": 1,
 "preset": "boxed",
 "font_stack": [
  "Inter",
  "Archivo Black",
  "sans-serif"
 ],
 "size_px": 62,
 "weight": 800,
 "case": "as-written",
 "fill": "#111111",
 "shadow": true,
 "position": {
  "y_pct": 70,
  "anchor": "center",
  "avoid": [
   "face",
   "overlay",
   "platform_buttons"
  ]
 },
 "chunking": {
  "max_words": 4,
  "syntax": "pipe-star",
  "hide_until_spoken": true
 },
 "animation": {
  "in": "pop",
  "out": "cut",
  "ms": 260,
  "active_word": "none"
 },
 "reveal": {
  "lead_ms": 60,
  "source": "whisper_words"
 },
 "bg_box": {
  "color": "#FFFFFF",
  "radius": 26
 }
}
