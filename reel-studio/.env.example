# Copy to .env. Every line is optional. Nothing here is a paid key: the toolkit works with none of them.
# Where voice models live (default ~/.reel-studio)
REEL_HOME=
# Software rendering for machines without a GPU (Linux servers/containers): swangle. Leave empty on a normal desktop.
REMOTION_GL=
# Parallel Chrome tabs while rendering (default 4; lower it on small machines)
REMOTION_CONCURRENCY=
# Optional: Agent-Reach binary if it is not on PATH (research: web, GitHub, YouTube search without keys)
AGENT_REACH_BIN=
# Optional: a browser cookie file for yt-dlp when a site asks "confirm you are not a bot"
YTDLP_COOKIES=
# Optional: your own API keys, only if YOU choose a paid service. The toolkit never requires them.
# OPENAI_API_KEY=
# ELEVENLABS_API_KEY=
