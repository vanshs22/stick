{
 "type": "object",
 "required": [
  "assets"
 ],
 "properties": {
  "assets": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "type",
     "path",
     "license",
     "original"
    ],
    "properties": {
     "id": {
      "type": "string",
      "minLength": 1
     },
     "type": {
      "type": "string",
      "enum": [
       "image",
       "video",
       "font",
       "audio",
       "model",
       "texture",
       "screenshot",
       "recording",
       "icon"
      ]
     },
     "path": {
      "type": "string",
      "minLength": 1
     },
     "source_url": {
      "type": "string"
     },
     "license": {
      "type": "string",
      "minLength": 1
     },
     "author": {
      "type": "string"
     },
     "captured_at": {
      "type": "string"
     },
     "original": {
      "type": "boolean"
     },
     "used_in": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "notes": {
      "type": "string"
     }
    }
   }
  }
 },
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "asset-manifest"
}