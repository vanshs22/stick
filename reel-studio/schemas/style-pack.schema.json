{
 "type": "object",
 "required": [
  "id",
  "name",
  "family",
  "description",
  "tokens",
  "rules"
 ],
 "properties": {
  "id": {
   "type": "string",
   "pattern": "^[a-z0-9-]+$"
  },
  "name": {
   "type": "string",
   "minLength": 1
  },
  "family": {
   "type": "string",
   "enum": [
    "2d",
    "3d",
    "mixed"
   ]
  },
  "description": {
   "type": "string",
   "minLength": 1
  },
  "tokens": {
   "type": "object",
   "required": [
    "colors",
    "fonts"
   ],
   "properties": {
    "colors": {
     "type": "object"
    },
    "fonts": {
     "type": "object"
    },
    "safe_zone": {
     "type": "object"
    }
   }
  },
  "rules": {
   "type": "array",
   "items": {
    "type": "string",
    "minLength": 1
   },
   "minItems": 1
  },
  "components": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "camera_language": {
   "type": "string"
  },
  "typography": {
   "type": "string"
  },
  "transitions": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "audio_direction": {
   "type": "string"
  },
  "pitfalls": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "references": {
   "type": "array",
   "items": {
    "type": "string"
   }
  }
 },
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "style-pack"
}