{
 "$comment": "A playbook is shared learning: rules learned from references, written once, used by every style. how_by_engine translates one idea into each renderer.",
 "type": "object",
 "required": ["schema_version", "id", "title", "entries"],
 "additionalProperties": false,
 "properties": {
  "schema_version": { "type": "integer", "minimum": 1 },
  "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
  "title": { "type": "string", "minLength": 3 },
  "read_by": { "type": "array", "items": { "type": "string" } },
  "entries": {
   "type": "array", "minItems": 1,
   "items": {
    "type": "object",
    "required": ["id", "when", "do", "evidence"],
    "additionalProperties": false,
    "properties": {
     "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
     "when": { "type": "string", "minLength": 3 },
     "do": { "type": "string", "minLength": 10 },
     "parameters": { "type": "object" },
     "styles": { "type": "array", "items": { "type": "string" } },
     "evidence": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["ref", "note"], "additionalProperties": false, "properties": { "ref": { "type": "string", "minLength": 1 }, "note": { "type": "string", "minLength": 3 } } } },
     "anti_patterns": { "type": "array", "items": { "type": "string" } },
     "how_by_engine": { "type": "object", "additionalProperties": false, "properties": { "2d-flat": { "type": "string" }, "sprite-in-3d": { "type": "string" }, "3d": { "type": "string" }, "face-cam": { "type": "string" }, "board": { "type": "string" } } },
     "check": { "type": "string" }
    }
   }
  }
 }
}
