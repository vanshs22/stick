   "type": "object"
  },
  "angle_dist": {
   "type": "object"
  },
  "shot_len": {
   "type": "object",
   "required": [
    "min",
    "median",
    "max"
   ],
   "additionalProperties": false,
   "properties": {
    "min": {
     "type": "number",
     "minimum": 0.2
    },
    "median": {
     "type": "number",
     "minimum": 0.2
    },
    "max": {
     "type": "number",
     "minimum": 0.2
    },
    "cv": {
     "type": "number",
     "minimum": 0
    }
   }
  },
  "per_beat": {
   "type": "object"
  },
