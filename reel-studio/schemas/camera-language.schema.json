     "type": "number",
     "minimum": 0
    }
   }
  },
  "hold_creep_pct_per_f": {
   "type": "array",
   "minItems": 2,
   "maxItems": 2,
   "items": {
    "type": "number",
    "minimum": 0,
    "maximum": 1
   }
  },
  "glide_frames": {
   "type": "array",
