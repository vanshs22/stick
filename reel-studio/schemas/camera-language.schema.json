    "maximum": 120
   }
  },
  "kick_frames": {
   "type": "integer",
   "minimum": 2,
   "maximum": 20
  },
  "roll_deg": {
   "type": "array",
   "minItems": 2,
   "maxItems": 2,
   "items": {
    "type": "number",
    "minimum": 0,
    "maximum": 15
   }
  },
  "max_still_frames": {
   "type": "integer",
   "minimum": 6,
   "maximum": 120
  }
 }
}
