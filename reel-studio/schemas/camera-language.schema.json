   "type": "boolean"
  },
  "max_hold_s": {
   "type": "number",
   "minimum": 0.5
  },
  "transitions": {
   "type": "object"
  },
  "beat_sync": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "snap_to": {
     "type": "string",
     "enum": [
      "word",
      "beat",
