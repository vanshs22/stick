{
 "type": "object",
 "required": ["schema_version", "stages", "overall", "status"],
 "additionalProperties": false,
 "properties": {
  "schema_version": { "type": "integer", "minimum": 1 },
  "stages": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": ["stage", "score", "weight", "pass_at", "round", "status"],
    "additionalProperties": false,
    "properties": {
     "stage": { "type": "string", "enum": ["script", "storyboard", "audio", "captions", "sfx", "overlays", "final"] },
     "score": { "type": "number", "minimum": 0, "maximum": 100 },
     "weight": { "type": "number", "minimum": 0, "maximum": 100 },
     "pass_at": { "type": "number", "minimum": 0, "maximum": 100 },
     "round": { "type": "integer", "minimum": 0, "maximum": 4 },
     "status": { "type": "string", "enum": ["pass", "revise", "fail", "escalate"] },
     "blockers": { "type": "array", "items": { "type": "string" } }
    }
   }
  },
  "overall": { "type": "number", "minimum": 0, "maximum": 100 },
  "status": { "type": "string", "enum": ["pass", "revise", "escalate"] }
 }
}
