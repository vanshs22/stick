{
 "type": "object",
 "required": ["schema_version", "characters"],
 "additionalProperties": false,
 "properties": {
  "schema_version": { "type": "integer", "minimum": 1 },
  "characters": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": ["id", "rig", "radius", "facing_model", "original"],
    "additionalProperties": false,
    "properties": {
     "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
     "rig": { "type": "string", "enum": ["svg", "sprite", "voxel", "lowpoly", "roblox", "faceted", "cube", "photo"] },
     "silhouette": { "type": "string", "minLength": 3 },
     "palette": { "type": "array", "items": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" } },
     "height_m": { "type": "number", "minimum": 0.1 },
     "radius": { "type": "number", "minimum": 0.05 },
     "footprint": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number", "minimum": 0.05 } },
     "facing_model": { "type": "string", "enum": ["rotY", "flipX", "billboard"] },
     "outline": { "type": "object", "additionalProperties": false, "properties": { "w": { "type": "number", "minimum": 0 }, "color": { "type": "string" } } },
     "face_sets": { "type": "array", "items": { "type": "string" } },
     "poses": { "type": "array", "items": { "type": "string" } },
     "voice": { "type": "object", "additionalProperties": false, "properties": { "engine": { "type": "string" }, "voice": { "type": "string" }, "speed": { "type": "number", "minimum": 0.5, "maximum": 1.6 }, "pitch": { "type": "number" } } },
     "original": { "type": "boolean" }
    }
   }
  }
 }
}
