{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "reference-analysis",
  "type": "object",
  "required": [
    "source",
    "kind",
    "size",
    "vision"
  ],
  "properties": {
    "source": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "video",
        "image"
      ]
    },
    "size": {
      "type": "array"
    },
    "duration": {
      "type": "number"
    },
    "shots": {
      "type": "array"
    },
    "timing": {
      "type": "object"
    },
    "camera": {
      "type": "object"
    },
    "look": {
      "type": "object"
    },
    "text": {
      "type": "object"
    },
    "qa": {
      "type": "object"
    },
    "audio": {
      "type": "object"
    },
    "vision": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "done",
            "unavailable"
          ]
        }
      }
    }
  }
}