{
 "type": "object",
 "required": [
  "fps",
  "width",
  "height",
  "duration",
  "shots",
  "captions",
  "words"
 ],
 "properties": {
  "fps": {
   "type": "number"
  },
  "width": {
   "type": "number"
  },
  "height": {
   "type": "number"
  },
  "duration": {
   "type": "number",
   "minimum": 1
  },
  "style": {
   "type": "string"
  },
  "shots": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "start",
     "end",
     "component"
    ],
    "properties": {
     "id": {
      "type": "string",
      "minLength": 1
     },
     "start": {
      "type": "number",
      "minimum": 0
     },
     "end": {
      "type": "number"
     },
     "component": {
      "type": "string",
      "minLength": 1
     },
     "props": {
      "type": "object"
     },
     "lines": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "anchors": {
      "type": "object"
     },
     "camera": {
      "type": "object"
     },
     "transition_out": {
      "type": "object"
     }
    }
   },
   "minItems": 1
  },
  "captions": {
   "type": "object",
   "required": [
    "preset",
    "chunks"
   ],
   "properties": {
    "preset": {
     "type": "string",
     "minLength": 1
    },
    "chunks": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "t0",
       "t1",
       "words"
      ],
      "properties": {
       "t0": {
        "type": "number"
       },
       "t1": {
        "type": "number"
       },
       "words": {
        "type": "array",
        "items": {
         "type": "object",
         "required": [
          "w",
          "t",
          "hi"
         ],
         "properties": {
          "w": {
           "type": "string",
           "minLength": 1
          },
          "t": {
           "type": "number"
          },
          "hi": {
           "type": "boolean"
          }
         }
        }
       }
      }
     }
    }
   }
  },
  "words": {
   "type": "array",
   "items": {
    "type": "object"
   }
  },
  "audio": {
   "type": "string"
  }
 },
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "timeline"
}