{
  "id": "original-creatures",
  "name": "Original creatures",
  "family": "3d",
  "description": "Small round-and-boxy original creatures with big vertical eyes and comic reactions on a clean studio set.",
  "tokens": {
    "colors": {
      "bg": "#0F4C5C",
      "ink": "#FFFFFF",
      "ink2": "#FFFFFF",
      "muted": "#9AD1D4",
      "card": "#0A3541",
      "accent": "#FFB547",
      "accentSoft": "#FFB54733",
      "good": "#4E9A5B",
      "bad": "#C94A3A"
    },
    "fonts": {
      "sans": "Inter",
      "serif": "InstrumentSerif",
      "mono": "JetBrainsMono"
    },
    "safe_zone": {
      "top": 180,
      "bottom": 1380,
      "caption_y": 1440,
      "right_margin": 120,
      "content_top": 260,
      "content_bottom": 1340
    },
    "chrome": "glass",
    "caption": {
      "fill": "#ffffff"
    }
  },
  "effects": {
    "bokeh": true,
    "vignette": 0.3
  },
  "rules": [
    "Original designs (shape, colour, eyes) so they are never mistaken for a protected character.",
    "Big simple eyes; the blink and the hop carry the emotion.",
    "Two to four creatures at most; each has its own colour and role (sceptic, fan, expert).",
    "Reaction shots: cut to the creature on the punchline word.",
    "Studio background stays plain."
  ],
  "components": [
    "Scene3D",
    "ChatBubbles",
    "BigStat",
    "Versus",
    "Highlight",
    "CommentBox"
  ],
  "camera_language": "Medium two-shots; close on a reaction.",
  "typography": "Friendly heavy sans.",
  "transitions": [
    "cut",
    "zoom",
    "whip"
  ],
  "audio_direction": "upbeat bed, boing on hops, pop on text",
  "pitfalls": [
    "Copying a famous mascot.",
    "More than 4 creatures.",
    "No reaction to the key word."
  ],
  "references": [
    "reference videos ref1, ref4, ref7 (creature idea only)"
  ],
  "defaults": {
    "captions": "word-pop",
    "shot_seconds": [
      1.5,
      3
    ],
    "music": "upbeat",
    "scene3d": {
      "set": "studio",
      "light": "studio",
      "characters": [
        {
          "variant": "stick",
          "pose": "think",
          "mood": "worried",
          "x": -0.7
        }
      ],
      "creatures": [
        {
          "kind": "box",
          "x": 0.4,
          "z": 0.5,
          "scale": 1.6,
          "color": "#2FA3A0"
        },
        {
          "kind": "cloud",
          "x": 1.0,
          "z": 0.3,
          "scale": 1.4,
          "color": "#E8643C"
        }
      ],
      "bg": "#0F4C5C"
    }
  }
}