# copy to studio.env and edit if your paths differ
FACELESS_HOME=/projects/sandbox/faceless-shorts/.faceless-home   # kokoro models + python venv (numpy, scipy, kokoro-onnx, faster-whisper)
FFMPEG_BIN=/projects/sandbox/faceless-shorts/bin                 # dir containing a full ffmpeg + ffprobe
CHROME=/root/.cache/ms-playwright/chromium_headless_shell-1255/chrome-headless-shell-linux64/chrome-headless-shell

# --- AI planner (optional, one short call per video; no key = free rule-based plan) ---
# 1st choice: FreeLLMAPI (github.com/tashfeenahmed/freellmapi, self-hosted, free tiers of many providers)
#FREELLM_BASE_URL=http://localhost:3001/v1
#FREELLM_API_KEY=freellmapi-xxxxxxxx      # the "unified key" from its Keys page
#FREELLM_MODEL=auto                        # or auto:fast / auto:smart
# fallback when FreeLLMAPI is down or rate-limited (tried in this order after it): OPENAI_API_KEY, then GEMINI/ANTHROPIC/OPENROUTER
#OPENAI_API_KEY=sk-...
#LLM_MODEL=gpt-4o-mini
